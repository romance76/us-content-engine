APP_NAME=Laravel
APP_TAGLINE="Short one-line description of the site"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The single admin account, created/updated idempotently by `php artisan db:seed`.
ADMIN_NAME="Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Shared bearer token the external AI content pipeline uses to call
# POST /api/ingest/articles and /api/ingest/keywords. Generate with:
# php artisan tinker --execute="echo Str::random(40);"
INGEST_API_TOKEN=

# Google Search Console verification meta tag content (the value from the
# "HTML tag" verification method, not the whole <meta> tag).
GOOGLE_SITE_VERIFICATION=

# Google AdSense publisher ID, e.g. ca-pub-1234567890123456
GOOGLE_ADSENSE_CLIENT=

# Naver Search Advisor (서치어드바이저) verification meta tag content.
NAVER_SITE_VERIFICATION=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible storage (DigitalOcean Spaces works as-is) — keeps uploaded
# cover images out of the droplet's disk so the app stays portable across
# servers/domains. Set FILESYSTEM_DISK=s3 once these are filled in and add
# AWS_ENDPOINT + AWS_URL for Spaces (see README "Portability" section).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_ENDPOINT=https://nyc3.digitaloceanspaces.com
# AWS_URL=https://your-space-name.nyc3.digitaloceanspaces.com

VITE_APP_NAME="${APP_NAME}"
